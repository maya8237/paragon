{
  "name": "paragon-logistics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./dev.ts",
    "build": "bun run typecheck && bun build ./index.html --outdir=dist --minify --sourcemap=linked --define process.env.NODE_ENV='\"production\"' && bun run build:public && bun run build:llms && bun run build:prerender",
    "build:public": "bun --eval \"const{cpSync}=require('node:fs');cpSync('public','dist',{recursive:true})\"",
    "build:llms": "bun run scripts/build-llms.ts",
    "build:prerender": "bun run scripts/prerender.ts",
    "build:pages": "PAGES=1 bun run build",
    "typecheck": "tsc --noEmit",
    "nx:figures": "bun run scripts/fetch-nx-figures.ts",
    "nx:figures:check": "bun run scripts/fetch-nx-figures.ts --check",
    "verify:translations": "bun run scripts/verify-translations.ts",
    "preview": "bun run ./serve-dist.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
